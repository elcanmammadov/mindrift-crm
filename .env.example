# --- Mindrift CRM environment ---
# Copy to server/.env (cp .env.example server/.env). All AI calls happen on the backend; never expose the key to the client.

# SQLite file, relative to server/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Real AI mode. Leave empty to run in demo mode.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET="change-me-to-a-long-random-string"

# true  = always demo mode (prepared demo results + limited rule-based analysis)
# false = real AI when ANTHROPIC_API_KEY is set (falls back to demo if the key is missing)
DEMO_MODE="true"

PORT=4000
# Where the React app is served from (used for CORS and for customer links)
FRONTEND_URL="http://localhost:5173"

# Optional
# COOKIE_SECURE="false"           # set true behind HTTPS
# AI_MAX_INPUT_CHARS=120000       # character budget for sources sent to the model
# AI_TIMEOUT_MS=120000
